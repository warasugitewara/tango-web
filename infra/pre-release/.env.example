TURNSTILE_SITE_KEY=
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=

# 以下はLXCホスト上の絶対パス。秘密値そのものは書かない。
DATABASE_URL_SECRET_FILE=/etc/tango/secrets/database_url
POSTGRES_PASSWORD_SECRET_FILE=/etc/tango/secrets/postgres_password
GUEST_TOKEN_PEPPER_SECRET_FILE=/etc/tango/secrets/guest_token_pepper
TURNSTILE_SECRET_FILE=/etc/tango/secrets/turnstile_secret
BETTER_AUTH_SECRET_FILE=/etc/tango/secrets/better_auth_secret
GOOGLE_CLIENT_SECRET_FILE=/etc/tango/secrets/google_client_secret
GITHUB_CLIENT_SECRET_FILE=/etc/tango/secrets/github_client_secret
CLOUDFLARE_TUNNEL_TOKEN_FILE=/etc/tango/secrets/cloudflare_tunnel_token
